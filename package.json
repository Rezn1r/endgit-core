{
  "name": "endgit-core",
  "version": "0.1.0",
  "description": "EndGit API Server — CI/CD + Plugin Marketplace for Endstone",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "pnpm --filter @endgit/database generate",
    "db:push": "pnpm --filter @endgit/database push",
    "db:migrate": "pnpm --filter @endgit/database migrate",
    "db:seed": "pnpm --filter @endgit/database seed",
    "db:studio": "pnpm --filter @endgit/database studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@endgit/database": "workspace:*",
    "@endgit/storage": "workspace:*",
    "@endgit/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/semver": "^7.5.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/two-tech-dev/endgit-core.git"
  }
}
